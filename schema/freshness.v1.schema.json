{
  "$id": "https://raw.githubusercontent.com/Panevschi-Ruslan/flowatlas/main/schema/freshness.v1.schema.json",
  "title": "<output>/freshness.json, each service's checkout and every file a build read",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "freshnessFormatVersion": {
      "type": "number",
      "const": 1
    },
    "builtAt": {
      "type": "string"
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "dirty": {
            "type": "boolean"
          },
          "dir": {
            "type": "string"
          },
          "files": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        "required": [
          "commit",
          "branch",
          "dirty",
          "dir",
          "files"
        ]
      }
    }
  },
  "required": [
    "freshnessFormatVersion",
    "builtAt",
    "services"
  ]
}

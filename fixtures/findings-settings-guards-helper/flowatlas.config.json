{
  "services": [
    { "name": "gateway", "repo": "./gateway", "type": "nestjs" },
    { "name": "orders", "repo": "./orders", "type": "nestjs", "baseUrlEnv": ["ORDERS_URL"] },
    { "name": "shipping", "repo": "./shipping", "type": "nestjs" },
    { "name": "ledger", "repo": "./ledger", "type": "express" },
    { "name": "reports", "repo": "./reports", "type": "nestjs" },
    { "name": "mailer", "repo": "./mailer", "type": "express" }
  ],
  "doctor": {
    "skipGuardDecorators": { "SkipStaffCheck": ["StaffGuard"] }
  },
  "output": ".flowatlas"
}

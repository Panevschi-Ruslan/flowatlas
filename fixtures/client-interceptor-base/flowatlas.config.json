{
  "services": [
    {
      "name": "orders",
      "repo": "./orders",
      "type": "nestjs"
    },
    {
      "name": "billing",
      "repo": "./billing",
      "type": "nestjs",
      "hosts": [
        "billing.example.test"
      ]
    },
    {
      "name": "reports",
      "repo": "./reports",
      "type": "nestjs"
    },
    {
      "name": "shop",
      "repo": "./shop",
      "type": "react",
      "apiBaseEnv": [
        "VITE_ORDERS_URL",
        "VITE_BILLING_URL"
      ],
      "apiTarget": {
        "VITE_ORDERS_URL": "orders",
        "VITE_BILLING_URL": "billing"
      }
    }
  ],
  "output": ".flowatlas"
}

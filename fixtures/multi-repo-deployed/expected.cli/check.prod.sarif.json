{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "flowatlas",
          "version": "0.5.1",
          "semanticVersion": "0.5.1",
          "informationUri": "https://panevschi-ruslan.github.io/flowatlas/",
          "rules": [
            {
              "id": "join/no-producer",
              "name": "join/no-producer",
              "shortDescription": {
                "text": "handler with nothing publishing to it"
              },
              "help": {
                "text": "After the deploy, nothing deployed publishes what this handler consumes. Deploy the publisher first, or ship both together.",
                "markdown": "After the deploy, nothing deployed publishes what this handler consumes. Deploy the publisher first, or ship both together."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "join/target-gone",
              "name": "join/target-gone",
              "shortDescription": {
                "text": "call whose route deploying removes"
              },
              "help": {
                "text": "A caller that is deployed asks for a route the version being deployed no longer serves. Deploy the caller first, keep the route, or ship both together.",
                "markdown": "A caller that is deployed asks for a route the version being deployed no longer serves. Deploy the caller first, keep the route, or ship both together."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "automationDetails": {
        "id": "flowatlas/check/"
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "description": {
            "text": "The directory flowatlas.config.json is in."
          }
        },
        "billing": {
          "uri": "billing/",
          "uriBaseId": "%SRCROOT%"
        },
        "gateway": {
          "uri": "gateway/",
          "uriBaseId": "%SRCROOT%"
        },
        "orders": {
          "uri": "orders/",
          "uriBaseId": "%SRCROOT%"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [

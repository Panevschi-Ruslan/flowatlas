generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CouponKind {
  PERCENT
  AMOUNT
}

model Coupon {
  id       String     @id
  code     String     @unique
  kind     CouponKind
  issuedTo String

  @@map("coupons")
}

model ApiToken {
  id    String @id
  token String @unique
}

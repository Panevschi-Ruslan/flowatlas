{
  "Comment": "Reserves the stock of a placed order, then charges for it.",
  "StartAt": "ReserveStock",
  "States": {
    "ReserveStock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${reserve_stock_arn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "ChargePayment"
    },
    "ChargePayment": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${charge_payment_arn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}

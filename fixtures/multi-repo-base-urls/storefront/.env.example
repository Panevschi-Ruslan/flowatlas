# Copy to .env and fill in. Committed for everybody to read.
ORDERS_API=http://orders:3000
SHIPPING_URL=https://api.shipping.example.com/v2
# A secret's name is never kept, whatever its value looks like.
API_KEY=https://keys.example.com/not-a-key
# A credential in an address is dropped with everything but the host.
AUDIT_URL=http://auditor:pa55word@audit.example.org/events?token=abc
DATABASE_URL=postgres://shop:shop@db:5432/shop
PORT=3000

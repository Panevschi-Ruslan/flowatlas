{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@rendered-mail/mail": [
        "../../packages/mail/src/index.tsx"
      ],
      "@rendered-mail/relay": [
        "../../packages/relay/src/index.ts"

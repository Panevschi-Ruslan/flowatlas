{
  "Comment": "Reads the inbox for a lapsed member, then stops.",
  "StartAt": "ReadInbox",
  "States": {
    "ReadInbox": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ReaderArn}",
        "Payload.$": "$"
      },
      "End": true
    }
  }
}

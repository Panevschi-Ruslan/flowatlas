{
  "Comment": "Checks a title out to a borrower: asks the members service about the borrower, the catalogue for a copy, writes the loan, tells the catalogue and the members service about it, and starts the members service's notices.",
  "StartAt": "CheckStanding",
  "States": {
    "CheckStanding": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${check_standing_arn}",
        "Payload": {
          "borrowerId.$": "$.borrowerId"
        }
      },
      "ResultSelector": {
        "standing.$": "$.Payload.standing"
      },
      "ResultPath": "$.borrower",
      "Next": "IsInGoodStanding"
    },
    "IsInGoodStanding": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.borrower.standing",
          "StringEquals": "good",
          "Next": "ReserveCopy"
        }
      ],
      "Default": "CheckoutRefused"
    },
    "ReserveCopy": {
      "Type": "Task",
      "Resource": "${reserve_copy_arn}",
      "ResultPath": "$.copy",
      "Catch": [
        {
          "ErrorEquals": ["NoCopyAvailable"],
          "Next": "CheckoutRefused"
        }
      ],
      "Next": "WriteLoan"
    },
    "WriteLoan": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "${loans_table}",
        "Item": {
          "loanId": {
            "S.$": "$$.Execution.Name"
          },
          "borrowerId": {
            "S.$": "$.borrowerId"
          },
          "copyId": {
            "S.$": "$.copy.copyId"
          }
        }
      },
      "ResultPath": null,
      "Next": "RequestCopyPull"
    },
    "RequestCopyPull": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl": "${copy_pulls_url}",
        "MessageBody": {
          "copyId.$": "$.copy.copyId",
          "borrowerId.$": "$.borrowerId"
        }
      },
      "ResultPath": null,
      "Next": "PublishCheckout"
    },
    "PublishCheckout": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${checkouts_topic_arn}",
        "Message.$": "States.JsonToString($)"
      },
      "ResultPath": null,
      "Next": "AnnounceCheckout"
    },
    "AnnounceCheckout": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "${library_bus_name}",
            "Source": "library.circulation",
            "DetailType": "LoanCheckedOut",
            "Detail": {
              "titleId.$": "$.titleId",
              "copyId.$": "$.copy.copyId"
            }
          }
        ]
      },
      "ResultPath": null,
      "Next": "SendCheckoutNotice"
    },
    "SendCheckoutNotice": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution",
      "Parameters": {
        "StateMachineArn": "${borrower_notices_arn}",
        "Input": {
          "borrowerId.$": "$.borrowerId",
          "notice": "checked-out"
        }
      },
      "End": true
    },
    "CheckoutRefused": {
      "Type": "Fail",
      "Error": "CheckoutRefused"
    }
  }
}

{
  "services": [
    {
      "name": "gateway",
      "repo": "./gateway",
      "type": "nestjs",
      "hosts": ["gateway.example.test"]
    },
    {
      "name": "orders",
      "repo": "./orders",
      "type": "nestjs",
      "baseUrlEnv": ["ORDERS_URL"],
      "hosts": ["orders.example.test"]
    },
    {
      "name": "billing",
      "repo": "./billing",
      "type": "nestjs",
      "baseUrlEnv": ["BILLING_URL"]
    },
    {
      "name": "web",
      "repo": "./web",
      "type": "angular",
      "apiBaseEnv": ["apiUrl", "ordersUrl"],
      "apiTarget": { "apiUrl": "gateway" }
    }
  ],
  "sharedPackages": ["@fx/contracts"],
  "output": ".flowatlas"
}

{
  "services": [
    { "name": "docs-api", "repo": "./docs-api", "type": "nestjs" },
    { "name": "notify-worker", "repo": "./notify-worker", "type": "nestjs" },
    { "name": "realtime-gateway", "repo": "./realtime-gateway", "type": "nestjs" }
  ],
  "adapters": {
    "broker": {
      "custom": [
        {
          "name": "space-bus",
          "channelKind": "channel",
          "producers": [
            {
              "receiverType": ["SpaceBus"],
              "method": "publish",
              "channelArg": 0,
              "payloadArg": 1,
              "kind": "event"
            }
          ],
          "subscribers": [
            {
              "receiverType": ["SpaceBus"],
              "method": "subscribe",
              "channelArg": 0,
              "handlerArg": 1,
              "kind": "event"
            }
          ]
        }
      ]
    }
  },
  "output": ".flowatlas"
}

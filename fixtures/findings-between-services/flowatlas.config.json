{
  "services": [
    {
      "name": "catalog-api",
      "repo": "./catalog-api",
      "type": "nestjs",
      "baseUrlEnv": ["CATALOG_API_URL"]
    },
    {
      "name": "legacy-api",
      "repo": "./legacy-api",
      "type": "nestjs",
      "baseUrlEnv": ["LEGACY_API_URL"]
    },
    { "name": "storefront", "repo": "./storefront", "type": "nestjs" }
  ],
  "adapters": {
    "broker": {
      "custom": [
        {
          "name": "event-bus",
          "channelKind": "channel",
          "producers": [
            {
              "receiverType": ["EventBus"],
              "method": "publish",
              "channelArg": 0,
              "payloadArg": 1,
              "kind": "event"
            }
          ]
        }
      ]
    }
  },
  "output": ".flowatlas"
}

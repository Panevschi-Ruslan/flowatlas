{
  "resource": {
    "aws_apigatewayv2_api": {
      "catalogue": {
        "name": "${local.prefix}-catalogue",
        "protocol_type": "HTTP"
      }
    },
    "aws_apigatewayv2_integration": {
      "get_item": {
        "api_id": "${aws_apigatewayv2_api.catalogue.id}",
        "integration_type": "AWS_PROXY",
        "integration_uri": "${aws_lambda_function.get_item.invoke_arn}",
        "payload_format_version": "2.0"
      },
      "add_item": {
        "api_id": "${aws_apigatewayv2_api.catalogue.id}",
        "integration_type": "AWS_PROXY",
        "integration_uri": "${module.add_item.invoke_arn}",
        "payload_format_version": "2.0"
      }
    },
    "aws_apigatewayv2_route": {
      "get_item": {
        "api_id": "${aws_apigatewayv2_api.catalogue.id}",
        "route_key": "GET /items/{itemId}",
        "target": "integrations/${aws_apigatewayv2_integration.get_item.id}"
      },
      "add_item": {
        "api_id": "${aws_apigatewayv2_api.catalogue.id}",
        "route_key": "POST /items",
        "target": "integrations/${aws_apigatewayv2_integration.add_item.id}",
        "authorization_type": "AWS_IAM"
      }
    }
  }
}

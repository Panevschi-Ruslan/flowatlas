{
  "//": "Written by the catalogue team's generator; edit the generator, not this file.",
  "terraform": {
    "required_providers": {
      "aws": { "source": "hashicorp/aws", "version": "~> 5.0" }
    }
  },
  "provider": {
    "aws": { "region": "${var.region}" }
  },
  "variable": {
    "region": { "type": "string", "default": "eu-west-1" },
    "stage": { "type": "string", "default": "dev" }
  },
  "locals": {
    "prefix": "library-${var.stage}"
  },
  "data": {
    "archive_file": {
      "catalogue": {
        "type": "zip",
        "source_dir": "${path.module}/../src",
        "output_path": "${path.module}/build/catalogue.zip"
      }
    }
  },
  "resource": {
    "aws_iam_role": {
      "lambda": {
        "name": "${local.prefix}-catalogue-lambda",
        "assume_role_policy": "${jsonencode({ Version = \"2012-10-17\", Statement = [{ Effect = \"Allow\", Action = \"sts:AssumeRole\", Principal = { Service = \"lambda.amazonaws.com\" } }] })}"
      }
    },
    "aws_dynamodb_table": {
      "items": {
        "name": "${local.prefix}-items",
        "hash_key": "itemId",
        "billing_mode": "PAY_PER_REQUEST",
        "attribute": [{ "name": "itemId", "type": "S" }]
      }
    }
  }
}

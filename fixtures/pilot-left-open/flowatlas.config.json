{
  "services": [
    { "name": "desk-api", "repo": "./desk-api", "type": "nestjs" },
    { "name": "push-worker", "repo": "./push-worker", "type": "nestjs" },
    {
      "name": "staff-web",
      "repo": "./staff-web",
      "type": "angular",
      "apiBaseEnv": ["apiUrl"],
      "apiTarget": { "apiUrl": "desk-api" }
    }
  ],
  "adapters": {
    "broker": {
      "custom": [
        {
          "name": "tenant-bus",
          "channelKind": "channel",
          "producers": [
            { "receiverType": ["TenantBus"], "method": "publish", "channelArg": 0, "payloadArg": 1, "kind": "event" }
          ],
          "subscribers": [
            { "receiverType": ["TenantBus"], "method": "subscribe", "channelArg": 0, "handlerArg": 1, "kind": "event" }
          ]
        }
      ]
    }
  },
  "output": ".flowatlas"
}

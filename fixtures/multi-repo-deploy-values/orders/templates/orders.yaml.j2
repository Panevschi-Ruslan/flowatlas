AWSTemplateFormatVersion: '2010-09-09'
Description: The orders of a shop, rendered by sceptre with the stack's sceptre_user_data.

Parameters:
  Prefix:
    Type: String
  Stage:
    Type: String
  EventsTopicName:
    Type: String
  InvoicesQueueName:
    Type: String

Resources:
  ShipRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal: { Service: lambda.amazonaws.com }
            Action: sts:AssumeRole

  Ship:
    Type: AWS::Lambda::Function
    Properties:
      FunctionName: !Sub ${Prefix}-${Stage}-ship
      Runtime: nodejs20.x
      Handler: {{ sceptre_user_data.handler }}
      Role: !GetAtt ShipRole.Arn
      Code: ../src
      Environment:
        Variables:
          EVENTS_TOPIC_ARN: !Sub arn:aws:sns:${AWS::Region}:${AWS::AccountId}:${EventsTopicName}
          INVOICES_QUEUE_URL: !Sub https://sqs.${AWS::Region}.amazonaws.com/${AWS::AccountId}/${InvoicesQueueName}

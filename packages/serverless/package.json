{
  "name": "@flowatlas/serverless",
  "version": "0.1.0",
  "description": "Reads a Serverless Framework service file - YAML, JSON or TypeScript - for its functions, the events that run them and the CloudFormation resources beside them. Compiled into the `flowatlas` command; not published on its own.",
  "license": "MIT",
  "author": {
    "name": "Ruslan Panevschi",
    "url": "https://github.com/Panevschi-Ruslan"
  },
  "homepage": "https://github.com/Panevschi-Ruslan/flowatlas#readme",
  "bugs": {
    "url": "https://github.com/Panevschi-Ruslan/flowatlas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Panevschi-Ruslan/flowatlas.git",
    "directory": "packages/serverless"
  },
  "keywords": [
    "serverless",
    "cloudformation",
    "aws-lambda",
    "static-analysis",
    "dependency-graph"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --testTimeout=60000"
  },
  "dependencies": {
    "@flowatlas/aws": "workspace:*",
    "@flowatlas/core": "workspace:*",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1"
  },
  "private": true
}

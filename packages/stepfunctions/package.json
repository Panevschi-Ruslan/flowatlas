{
  "name": "@flowatlas/stepfunctions",
  "version": "0.1.0",
  "description": "Reads a state machine written in the Amazon States Language and draws it as a workflow and its steps. Compiled into the `flowatlas` command; not published on its own.",
  "license": "MIT",
  "author": {
    "name": "Ruslan Panevschi",
    "url": "https://github.com/Panevschi-Ruslan"
  },
  "homepage": "https://github.com/Panevschi-Ruslan/flowatlas#readme",
  "bugs": {
    "url": "https://github.com/Panevschi-Ruslan/flowatlas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Panevschi-Ruslan/flowatlas.git",
    "directory": "packages/stepfunctions"
  },
  "keywords": [
    "monorepo",
    "polyrepo",
    "static-analysis",
    "dependency-graph",
    "step-functions",
    "amazon-states-language",
    "architecture"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@flowatlas/core": "workspace:*",
    "yaml": "^2.9.1"
  },
  "private": true
}
